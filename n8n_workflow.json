      ],
      "id": "67688d1e-6750-4fc3-8e6a-f1375429e050",
      "name": "Upsert Customer and Session",
      "credentials": {
        "postgres": {
          "id": "dw4LfSY4r5SsxibM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COALESCE(\n        JSONB_AGG(\n            JSONB_BUILD_OBJECT(\n                'id', i.id,\n                'name', i.name,\n                'aliases', i.aliases,\n                'description', i.description,\n                'category', c.name,\n                'variants', (\n                    SELECT JSONB_AGG(\n                        JSONB_BUILD_OBJECT(\n                            'id', v.id,\n                            'size', v.size,\n                            'price', v.price\n                        )\n                        ORDER BY v.price\n                    )\n                    FROM menu_variants v\n                    WHERE v.menu_item_id = i.id\n                      AND v.active = TRUE\n                )\n            )\n            ORDER BY c.display_order, i.name\n        ),\n        '[]'::JSONB\n    ) AS menu,\n    COALESCE(\n        (\n            SELECT JSONB_AGG(\n                JSONB_BUILD_OBJECT(\n                    'id', e.id,\n                    'name', e.name,\n                    'type', e.extra_type,\n                    'price', e.price\n                )\n                ORDER BY e.name\n            )\n            FROM menu_extras e\n            WHERE e.active = TRUE\n        ),\n        '[]'::JSONB\n    ) AS extras\nFROM menu_items i\nJOIN menu_categories c ON c.id = i.category_id\nWHERE i.active = TRUE\n  AND c.active = TRUE;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1136,
        -112
      ],
      "id": "633f4a17-7a8c-480b-ae79-0888d9ca203b",
