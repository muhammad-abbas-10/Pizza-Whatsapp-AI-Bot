    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH session_data AS (\n  SELECT\n    cs.customer_id,\n    cs.cart,\n    cs.order_type,\n    cs.delivery_address\n  FROM conversation_sessions cs\n  WHERE cs.customer_id = $1\n),\ncart_totals AS (\n  SELECT\n    customer_id,\n    cart,\n    order_type,\n    delivery_address,\n    COALESCE((SELECT SUM((item->>'line_total')::numeric)\n              FROM jsonb_array_elements(cart->'items') AS item), 0) AS subtotal\n  FROM session_data\n),\nsettings AS (\n  SELECT delivery_charge FROM restaurant_settings WHERE id = 1\n),\nnew_order AS (\n  INSERT INTO orders (customer_id, items, order_type, delivery_address, subtotal, delivery_charge, total)\n  SELECT\n    ct.customer_id,\n    ct.cart->'items',\n    COALESCE(ct.order_type, 'pickup'),\n    ct.delivery_address,\n    ct.subtotal,\n    CASE WHEN ct.order_type = 'delivery' THEN s.delivery_charge ELSE 0 END,\n    ct.subtotal + CASE WHEN ct.order_type = 'delivery' THEN s.delivery_charge ELSE 0 END\n  FROM cart_totals ct, settings s\n  WHERE jsonb_array_length(ct.cart->'items') > 0\n  RETURNING *\n),\ncleared_session AS (\n  UPDATE conversation_sessions\n  SET cart = '{\"items\": []}'::jsonb,\n      awaiting_confirmation = FALSE\n  WHERE customer_id = $1\n    AND EXISTS (SELECT 1 FROM new_order)\n)\nSELECT * FROM new_order;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Customer and Session').item.json.customer_id ] }}"
        }
      },
