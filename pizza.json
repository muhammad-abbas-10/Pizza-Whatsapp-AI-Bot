    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new_items AS (\n  SELECT\n    (elem->>'menu_item_id')::bigint AS menu_item_id,\n    (elem->>'variant_id')::bigint AS variant_id,\n    (elem->>'quantity')::int AS quantity,\n    COALESCE(elem->'extra_ids', '[]'::jsonb) AS extra_ids\n  FROM jsonb_array_elements($1::jsonb) AS elem\n),\nvalidated_items AS (\n  SELECT\n    ni.menu_item_id,\n    v.id AS variant_id,\n    mi.name AS item_name,\n    v.size,\n    ni.quantity,\n    v.price,\n    ni.extra_ids\n  FROM new_items ni\n  JOIN menu_variants v\n    ON v.id = ni.variant_id\n   AND v.menu_item_id = ni.menu_item_id\n   AND v.active = TRUE\n  JOIN menu_items mi\n    ON mi.id = ni.menu_item_id\n   AND mi.active = TRUE\n),\ncurrent_cart AS (\n  SELECT COALESCE(cart->'items', '[]'::jsonb) AS items\n  FROM conversation_sessions\n  WHERE customer_id = $2\n),\nexisting_items AS (\n  SELECT\n    (existing->>'menu_item_id')::bigint AS menu_item_id,\n    (existing->>'variant_id')::bigint AS variant_id,\n    existing->>'item_name' AS item_name,\n    existing->>'size' AS size,\n    (existing->>'quantity')::int AS quantity,\n    (existing->>'price')::numeric AS price,\n    COALESCE(existing->'extra_ids', '[]'::jsonb) AS extra_ids\n  FROM current_cart cc, LATERAL jsonb_array_elements(cc.items) AS existing\n),\nmerged_items AS (\n  SELECT\n    COALESCE(ei.menu_item_id, vi.menu_item_id) AS menu_item_id,\n    COALESCE(ei.variant_id, vi.variant_id) AS variant_id,\n    COALESCE(vi.item_name, ei.item_name) AS item_name,\n    COALESCE(vi.size, ei.size) AS size,\n    COALESCE(ei.quantity, 0) + COALESCE(vi.quantity, 0) AS quantity,\n    COALESCE(vi.price, ei.price) AS price,\n    COALESCE(vi.extra_ids, ei.extra_ids, '[]'::jsonb) AS extra_ids\n  FROM existing_items ei\n  FULL OUTER JOIN validated_items vi\n    ON ei.menu_item_id = vi.menu_item_id\n   AND ei.variant_id = vi.variant_id\n),\nfinal_items AS (\n  SELECT\n    menu_item_id, variant_id, item_name, size, quantity, price, extra_ids,\n    (price * quantity) AS line_total\n  FROM merged_items\n),\nupdated AS (\n  UPDATE conversation_sessions\n  SET cart = jsonb_build_object(\n        'items', (SELECT COALESCE(jsonb_agg(to_jsonb(fi)), '[]'::jsonb) FROM final_items fi)\n      ),\n      updated_at = NOW()\n  WHERE customer_id = $2\n  RETURNING cart\n)\nSELECT * FROM updated;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.output.items), $('Upsert Customer and Session').item.json.customer_id ] }}"
        }
      },
